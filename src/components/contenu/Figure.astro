---
// Conteneur de figure ou de simulation : légende sous la figure, largeur au choix.
interface Props {
  legende?: string;
  largeur?: 'colonne' | 'large';
  credit?: string;
}
const { legende, largeur = 'large', credit } = Astro.props;
---
<figure class:list={['figure', { deborde: largeur === 'large' }]}>
  <div class="contenu"><slot /></div>
  {
    (legende || credit) && (
      <figcaption>
        {legende && <span set:html={legende} />}
        {credit && <span class="credit">{credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin-block: 2.2rem;
  }
  figcaption {
    max-width: var(--colonne);
    margin: 0.75rem auto 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--encre-3);
  }
  .credit {
    display: block;
    font-size: 0.82rem;
    margin-top: 0.2rem;
  }
</style>
