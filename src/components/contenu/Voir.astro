---
// Lien rapide vers la leçon qui explique une notion : <Voir l="06-hdr/05-courbe-de-reponse">courbe de réponse</Voir>.
// Affiche le numéro du chapitre (dans sa couleur) et, au survol, le titre de la leçon.
// Un identifiant inconnu fait échouer la compilation : pas de lien cassé possible.
import { getCours } from '@/lib/navigation';

interface Props {
  /** identifiant de la leçon : "<dossier du chapitre>/<fichier sans .mdx>" */
  l: string;
}
const { l } = Astro.props;
const cours = await getCours();
const [idChap] = l.split('/');
const chapitre = cours.chapitres.find((c) => c.id === idChap);
const lecon = chapitre?.lecons.find((x) => x.entree.id === l);
if (!chapitre || !lecon) throw new Error(`<Voir> : leçon introuvable « ${l} »`);
const titre = `Chapitre ${chapitre.code} · ${lecon.titre} (${lecon.entree.data.duree} min)`;
---
<a
  class="voir"
  href={lecon.url}
  title={titre}
  style={`--accent-clair:${chapitre.accent.clair};--accent-sombre:${chapitre.accent.sombre}`}
><slot /><span class="code" aria-hidden="true">{chapitre.code}</span><span class="sr">(voir la leçon {titre})</span></a>

<style>
  .voir {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--accent) 70%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
    transition: color 0.15s var(--ease), text-decoration-color 0.15s var(--ease);
  }
  .voir:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .code {
    display: inline-block;
    margin-left: 0.18em;
    padding: 0 0.28em;
    border-radius: 4px;
    font-size: 0.66em;
    font-weight: 700;
    line-height: 1.45;
    vertical-align: 0.35em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
    background: color-mix(in oklch, var(--accent) 14%, transparent);
    text-decoration: none;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
