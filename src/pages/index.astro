---
import Base from '@/layouts/Base.astro';
import ThemeToggle from '@/components/nav/ThemeToggle.astro';
import CarteLumiere from '@/components/carte/CarteLumiere.astro';
import { getCours } from '@/lib/navigation';
import { accent } from '@/lib/spectre';

const cours = await getCours();
const nbLecons = cours.chapitres.reduce((s, c) => s + c.lecons.length, 0);
const duree = cours.chapitres.reduce((s, c) => s + c.duree, 0);
---
<Base titre="Carte" accent={accent(520)} classe="accueil">
  <header class="haut large">
    <span class="marque">CSED520 · Computational Imaging</span>
    <ThemeToggle />
  </header>

  <main>
    <section class="intro large">
      <h1>
        Imagerie <em>computationnelle</em>
      </h1>
      <p class="accroche">
        De la lumière à l’image, puis de l’image à l’information. Un cours en français, illustré et interactif,
        construit à partir des cours de POSTECH.
      </p>
      <p class="chiffres etiquette">
        {cours.chapitres.length} chapitres · {nbLecons} leçons · ≈ {Math.round(duree / 60)} h de lecture
      </p>
    </section>

    <section class="large trajet" aria-labelledby="titre-carte">
      <h2 id="titre-carte" class="etiquette">Le trajet de la lumière</h2>
      <CarteLumiere chapitres={cours.chapitres} assignments={cours.assignments} />
    </section>

    {
      cours.assignments.length > 0 && (
        <section class="large assignments" aria-labelledby="titre-assign">
          <h2 id="titre-assign" class="etiquette">Assignments</h2>
          <div class="grille">
            {cours.assignments.map((a) => (
              <a
                class="assign"
                href={a.url}
                style={`--accent-clair:${a.accent.clair};--accent-sombre:${a.accent.sombre}`}
              >
                <span class="code">{a.entree.data.code}</span>
                <span class="t">{a.entree.data.titre}</span>
                <span class="r">{a.entree.data.resume}</span>
                <span class="date">À rendre : {a.entree.data.rendu}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <footer class="large pied">
    <p>
      Notes de cours personnelles d’après CSED520 / AIGS529 (POSTECH, automne 2026, Prof. Seung-Hwan Baek). Textes,
      schémas et simulations sont originaux ; les travaux de recherche cités sont référencés en lien.
    </p>
  </footer>
</Base>

<style>
  .haut {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--barre-h);
  }
  .marque {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--encre-3);
  }
  .intro {
    padding: clamp(3rem, 10vw, 7rem) 0 clamp(2rem, 5vw, 3.5rem);
  }
  h1 {
    font-size: clamp(2.8rem, 9vw, 6rem);
    font-weight: 380;
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-variation-settings: 'SOFT' 50;
  }
  h1 em {
    font-style: italic;
    font-weight: 300;
    background: linear-gradient(90deg, #6a3fa8, #3657b5 20%, #2f8a9a 40%, #4f9a4a 55%, #c9962c 72%, #d0612a 86%, #9a2b2b);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.06em;
  }
  .accroche {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    font-size: clamp(1.15rem, 2.4vw, 1.35rem);
    line-height: 1.5;
    color: var(--encre-2);
  }
  .chiffres {
    margin-top: 1.5rem;
  }
  .trajet h2,
  .assignments h2 {
    margin-bottom: 1.75rem;
  }
  .assignments {
    margin-top: 5rem;
  }
  .grille {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
  }
  .assign {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.2rem 1.3rem;
    border: 1px solid var(--filet);
    border-radius: 14px;
    text-decoration: none;
    transition: border-color 0.25s var(--ease), transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .assign:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: var(--ombre);
    color: inherit;
  }
  .assign .code {
    font-family: var(--f-titre);
    font-size: 2.2rem;
    font-weight: 300;
    line-height: 1;
    color: var(--accent);
  }
  .assign .t {
    font-family: var(--f-titre);
    font-size: 1.25rem;
  }
  .assign .r {
    color: var(--encre-2);
    font-size: 0.95rem;
  }
  .assign .date {
    margin-top: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--encre-3);
  }
  .pied {
    margin-top: 6rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--filet);
    font-size: 0.85rem;
    color: var(--encre-3);
  }
</style>
