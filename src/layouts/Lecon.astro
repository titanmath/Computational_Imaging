---
// Gabarit commun aux leçons de chapitre et aux étapes d'assignment.
import Base from './Base.astro';
import TopBar, { type Miette, type Segment } from '@/components/nav/TopBar.astro';
import PrecSuiv from '@/components/nav/PrecSuiv.astro';
import type { Accent } from '@/lib/spectre';
import type { Page } from '@/lib/navigation';

interface Props {
  titre: string;
  resume: string;
  surtitre: string;
  duree?: number;
  accent: Accent;
  fil: Miette[];
  segments: Segment[];
  prec?: Page;
  suiv?: Page;
  finHref?: string;
  finLabel?: string;
  /** Bandeaux affichés sous le titre (ex. « Utilisé dans A2 »). */
  liens?: { label: string; href: string }[];
  complement?: string;
  essentiel?: boolean;
}
const p = Astro.props;
---
<Base titre={p.titre} description={p.resume} accent={p.accent}>
  <TopBar slot="barre" fil={p.fil} segments={p.segments} />
  <main class="lecon" class:list={{ essentiel: p.essentiel }}>
    <header class="entete colonne">
      <p class="etiquette surtitre">
        <span>{p.surtitre}</span>
        {p.duree && <span class="duree">{p.duree} min</span>}
      </p>
      <h1>{p.titre}</h1>
      <p class="chapeau">{p.resume}</p>
      {
        (p.liens?.length || p.complement) && (
          <div class="bandeaux">
            {p.liens?.map((l) => (
              <a class="bandeau lien" href={l.href}>
                {l.label}
              </a>
            ))}
            {p.complement && <span class="bandeau complement">{p.complement}</span>}
          </div>
        )
      }
    </header>
    <article class="prose colonne">
      <slot />
    </article>
    <PrecSuiv prec={p.prec} suiv={p.suiv} finHref={p.finHref} finLabel={p.finLabel} />
  </main>
</Base>

<style>
  .lecon {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }
  .entete {
    margin-bottom: 2.25rem;
  }
  .surtitre {
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
    margin: 0 0 0.9rem;
    color: var(--accent);
  }
  .duree {
    color: var(--encre-3);
    font-weight: 500;
    letter-spacing: 0.06em;
  }
  h1 {
    font-size: clamp(2rem, 5.4vw, 3rem);
    font-weight: 450;
    font-variation-settings: 'SOFT' 40, 'WONK' 0;
  }
  .chapeau {
    margin: 1rem 0 0;
    font-size: 1.22rem;
    line-height: 1.5;
    color: var(--encre-2);
    max-width: 38rem;
  }
  .bandeaux {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.2rem;
  }
  .bandeau {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--filet-fort);
    color: var(--encre-2);
    text-decoration: none;
  }
  .bandeau.lien::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .bandeau.lien:hover {
    border-color: var(--accent);
  }
  .bandeau.complement {
    border-style: dashed;
    color: var(--ambre);
    border-color: color-mix(in oklab, var(--ambre) 55%, transparent);
  }
</style>
